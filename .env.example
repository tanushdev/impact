# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/impact_oil_gas
# or MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/impact_oil_gas?retryWrites=true&w=majority

# Brevo (formerly Sendinblue) API Key
BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# Brevo Sender Email & Name (Must be verified in Brevo)
BREVO_SENDER_EMAIL=info@impactoilandgas.com
BREVO_SENDER_NAME=Impact Energies International

# Notification Recipient for Contact Inquiries & Job Applications
ADMIN_NOTIFICATION_EMAIL=info@impactoilandgas.com

